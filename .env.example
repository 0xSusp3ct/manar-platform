NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.example
DATABASE_PATH=./data/manar.db
COOKIE_SECURE=true
TRUST_PROXY=1

# Generate once, store securely, and do not rotate without a migration/restore plan.
# It protects tokens and derives the encryption key for recoverable access codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-at-least-32-random-characters

# First owner account. The account is created on the first start only.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# current50 preserves the live website. guide48 follows the PDF guide exactly.
SCORING_PROFILE=current50

# Vercel deployment: injected automatically by the Turso Cloud integration.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# When both values are configured with a verified Resend sender/domain, public
# registration issues and emails the access code immediately and completed
# assessments email their private report link. Delivery failure stays pending.
RESEND_API_KEY=
RESEND_FROM=Manar <reports@your-domain.example>
